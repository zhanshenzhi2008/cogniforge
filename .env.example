# =====================================================================
# cogniforge 生产环境变量
# cp .env.example .env  # 然后填真实值
# =====================================================================

# ─── 镜像命名空间（CD 自动注入，也可手动覆盖）─────────────
IMAGE_NAMESPACE=zhanshenzhi2008

# ─── 域名（Traefik 路由）────────────────────────────────────
DOMAIN=cogniforge.example.com

# ─── 数据库（公用 ../envs/db.env，必须与 .env.db 一致）────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_secure_random_password_at_least_16_chars
POSTGRES_DB=cogniforge

# ─── 安全密钥（openssl rand -base64 32 生成）───────────────
ENCRYPTION_KEY=change_me_to_a_secure_random_key_at_least_32_chars
JWT_SECRET=change_me_to_a_secure_jwt_secret_at_least_32_chars

# ─── LLM API Keys 已移到 ../envs/llm.env（共享给 AI / 后端）──────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
