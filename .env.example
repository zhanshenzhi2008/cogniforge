# =====================================================================
# cogniforge 生产环境变量
# cp .env.example .env  # 然后填真实值
# =====================================================================

# ─── 镜像命名空间（CD 自动注入，也可手动覆盖）─────────────
IMAGE_NAMESPACE=zhanshenzhi2008

# ─── 时区（默认由 Dockerfile ENV=Asia/Shanghai；仅覆盖时解开）─
# TZ=Asia/Shanghai

# ─── 域名（Traefik 路由）────────────────────────────────────
DOMAIN=cogniforge.example.com

# ─── 运行模式 / 端口（生产共享 .env；compose 只 env_file，不写死）─
# Go：Dockerfile 默认 GIN_MODE=release；本地调试可改 debug
GIN_MODE=release
# Go 监听端口（COGNIFORGE_PORT；兼容旧名 PORT）。AI 为 8086，勿混用。
COGNIFORGE_PORT=8080

# ─── 服务互访（生产 compose 网络内用容器名）────────────────
# Go → AI（RAG / 知识库）；代码读 RAG_PYTHON_URL，不是 AI_SERVICE_URL
RAG_PYTHON_URL=http://cogniforge-ai:8086
# AI → Go（聊天/向量）；cogniforge-ai 读此变量
COGNIFORGE_API_URL=http://cogniforge:8080

# ─── 数据库（经 external 网络 db-net 访问）────────────────────────
# PostgreSQL
PGSQL_HOST=pgsql
PGSQL_PORT=5432
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=change_me_to_a_secure_random_password_at_least_16_chars
PGSQL_DB=cogniforge
PGSQL_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PWD=

# ─── 安全密钥（openssl rand -base64 32 生成）───────────────
ENCRYPTION_KEY=change_me_to_a_secure_random_key_at_least_32_chars
JWT_SECRET=change_me_to_a_secure_jwt_secret_at_least_32_chars

# ─── 邮件（忘记密码；推荐 QQ SMTP，无需自有域名）──────────
# 启动时会自动 Load 本文件：IDEA/系统已有的同名变量优先，.env 只补缺。
# Working directory 请设为仓库根目录，以便找到 .env。
# 1) QQ/Foxmail → 设置 → 账户 → 开启 SMTP → 生成授权码
# 2) MAIL_FROM 必须和 SMTP_USER 是同一个邮箱
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq@qq.com
SMTP_PASSWORD=change_me_to_qq_smtp_auth_code
MAIL_FROM="CogniForge <your_qq@qq.com>"

# 可选：Resend（需要已验证的自有域名）
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=CogniForge <noreply@example.com>

# ─── LLM 密钥不要写在这里 ──────────────────────────────────
# 供应商 / 模型 / API Key 在控制台「模型」页配置，写入 PostgreSQL ai_providers。
# 请删除本文件及服务器 .env 中的：
#   AI_PROVIDER  AI_BASE_URL  AI_API_KEY  AI_DEFAULT_MODEL
#   OPENROUTER_HTTP_REFERER  OPENROUTER_TITLE
#   OPENAI_API_KEY  ANTHROPIC_API_KEY  OPENROUTER_API_KEY
# （cogniforge-ai 通过 COGNIFORGE_API_URL 回调本服务聊天/向量，不要在 Python .env 里再写 LLM Key）

# ─── RAG（阶段十三：对话检索默认值；请求体 rag_top_k / rag_min_score 可覆盖）──
# 本地开发可将上方 RAG_PYTHON_URL 改为 http://localhost:8086
RAG_TOP_K=3
RAG_MIN_SCORE=0.5
RAG_MAX_TOKENS=2000

# ─── cogniforge-ai 专用（共享 .env 时一并写在这里）──────────
EMBEDDER_TYPE=go
# UPLOAD_BASE_DIR=/app/uploads
# LOG_LEVEL=info
# LOG_FORMAT=json

# ─── MCP code_execute（阶段十五 15.5）──────────────────────
# 本地子进程沙箱（非 Docker）：临时目录 + 超时 30s（最大 60）+ 输出截断
# 宿主机/容器内需有对应解释器：python3 / node / go
# 生产不想开放时设为 1 或 true：
# CODE_EXECUTE_DISABLED=1

# ─── 网络搜索（内置 MCP 工具 web_search 使用）─────────────
# Tavily API：https://app.tavily.com
# - 注册后每月 1000 次免费额度，无需信用卡
# - 不填则使用 keyless 模式（有频率限制，适合开发测试）
TAVILY_API_KEY=
